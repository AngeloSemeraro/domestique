# Copy this file to scripts/.env.deploy and fill it in.
# scripts/.env.deploy is gitignored — it stays on your machine, never on GitHub.

# Connection method: sftp (SSH, port 22) | ftps (FTP over TLS, port 21) | ftp (plain, port 21)
# Try sftp first. If your host only allows the FTP sub-account (common on
# shared cPanel hosting), use ftps.
DEPLOY_METHOD=sftp

DEPLOY_HOST=vms.qxk.mybluehost.me
DEPLOY_PORT=22
DEPLOY_USER=apt4ftp@apt4.studio
DEPLOY_PASS=change-me

# Remote path to the plugin folder, relative to what this account sees as its
# root. On many setups it's wp-content/plugins/domestique; on others you must
# prefix the docroot, e.g. public_html/wp-content/plugins/domestique.
PLUGIN_REMOTE_DIR=wp-content/plugins/domestique
