#!/bin/bash
#
# Domestique.app launcher — starts the local server and opens Domestique in
# Safari. No Terminal window. The app stays in the Dock (with the Domestique
# icon) while it runs; right-click its Dock icon -> Quit to stop it.
#
# For a chromeless standalone window with the Domestique icon, open it once in
# Safari and choose File -> Add to Dock.
#
# The bundle lives at <repo>/Domestique.app, so the repo root is three
# levels up from this executable.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$ROOT" || exit 1

URL="http://localhost:3000"
LOG="$ROOT/.domestique-launch.log"

# GUI apps launch with a minimal PATH that usually omits Homebrew and the
# nodejs.org installer location — add the common spots so `node` is found.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

dialog() {
  /usr/bin/osascript -e "display dialog \"$1\" buttons {\"OK\"} default button 1 with icon $2 with title \"Domestique\"" >/dev/null 2>&1
}

# Open the app in Safari (falling back to the default browser).
open_app() {
  local url="$1"
  if [ -d "/Applications/Safari.app" ]; then
    open -a Safari "$url"
  else
    open "$url"
  fi
}

# Already running? Just open the window.
if /usr/sbin/lsof -ti tcp:3000 >/dev/null 2>&1; then
  open_app "$URL"
  exit 0
fi

# Node/npm present?
if ! command -v npm >/dev/null 2>&1; then
  dialog "Node.js non è installato.\n\nScaricalo (versione LTS) da nodejs.org, installalo e riprova." caution
  open "https://nodejs.org"
  exit 1
fi

# First run: install dependencies.
if [ ! -d node_modules ]; then
  /usr/bin/osascript -e 'display notification "Primo avvio: installo le dipendenze…" with title "Domestique"' >/dev/null 2>&1
  if ! npm install >"$LOG" 2>&1; then
    dialog "Installazione delle dipendenze fallita.\n\nDettagli in .domestique-launch.log nella cartella del progetto." stop
    exit 1
  fi
fi

# Open the app window as soon as the server answers.
(
  for _ in $(seq 1 90); do
    if /usr/bin/curl -s -o /dev/null "$URL"; then
      open_app "$URL"
      break
    fi
    sleep 1
  done
) &

# Run the server as a CHILD (not `exec`) and wait on it. `exec` replaced this
# script's process with node, which made the Dock show the Node icon instead
# of Domestique's; keeping this script as the foreground process preserves the
# bundle's identity and icon. On Quit, stop whatever is listening on :3000.
npm run dev >"$LOG" 2>&1 &
DEV_PID=$!
cleanup() {
  local pids
  pids="$(/usr/sbin/lsof -ti tcp:3000 2>/dev/null)"
  [ -n "$pids" ] && kill $pids 2>/dev/null
}
trap cleanup EXIT TERM INT
wait "$DEV_PID"
