# Strava API credentials — get them from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Base URL where the app runs (no trailing slash).
# Self-hosted default; must match the Authorization Callback Domain of your
# Strava API app (use "localhost" there for this value).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ char random string used to encrypt the session cookie
# Generate with:  openssl rand -base64 32
SESSION_SECRET=
