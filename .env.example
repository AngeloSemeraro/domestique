# Strava API credentials — get them from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Base URL where the app runs (no trailing slash).
# Self-hosted default; must match the Authorization Callback Domain of your
# Strava API app (use "localhost" there for this value).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ char random string used to encrypt the session cookie
# Generate with:  openssl rand -base64 32
SESSION_SECRET=

# --- Optional: RideWithGPS integration (Batch edit tab → "Send / export") ---
# Register a free API client on your RideWithGPS account (see the docs at
# https://ridewithgps.com/api/v1/doc), set its redirect URI to
#   <NEXT_PUBLIC_APP_URL>/api/rwgps/auth/callback
# and paste the credentials here. Leave empty to hide the feature.
RWGPS_CLIENT_ID=
RWGPS_CLIENT_SECRET=
# Only needed if your RWGPS API key differs from the OAuth client id.
RWGPS_API_KEY=
