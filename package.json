{
  "name": "ascii-visualizer",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Real-time ASCII art filter for your webcam. Runs standalone or embedded in any page (WordPress-ready).",
  "type": "module",
  "keywords": [
    "ascii",
    "ascii-art",
    "webcam",
    "camera",
    "filter",
    "canvas",
    "visualizer"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:embed": "vite build --mode embed",
    "build:all": "npm run build && npm run build:embed",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
