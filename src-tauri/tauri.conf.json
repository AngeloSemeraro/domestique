{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Domestique",
  "version": "0.7.0",
  "identifier": "com.domestique.desktop",
  "build": {
    "frontendDist": "loading",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Domestique",
        "width": 1240,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html",
        "visible": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Edit, merge and clean up your Strava rides.",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
