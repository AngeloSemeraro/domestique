{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Domestique",
  "version": "0.7.0",
  "identifier": "com.domestique.desktop",
  "build": {
    "frontendDist": "loading",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Edit, merge and clean up your Strava rides.",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
